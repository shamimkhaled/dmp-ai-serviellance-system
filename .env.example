# ─────────────────────────────────────────────
# VMS Intelligence — environment template
# Copy to `.env` (gitignored) and fill in real values.
# Never commit `.env` or production passwords.
# ─────────────────────────────────────────────

# Public IP or hostname browsers use to reach this server.
# Used for MediaMTX WebRTC/WHEP ICE candidates and dashboard URLs.
# Local: localhost
HOST_IP=localhost

# PostgreSQL. Default compose service: postgres (pai_postgres, host port 5433).
# DATABASE_URL=postgresql://policeai:policeai_dev_secret@postgres:5432/policeai
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Alert-service leftover HS256 secret (APIs verify Keycloak RS256). Generate a long random value.
JWT_SECRET=change-me-generate-a-long-random-string

# keycloak (default) | off (lab: treat every caller as local admin)
AUTH_MODE=keycloak

# Keycloak is localhost-only (127.0.0.1:8080). Independent of HOST_IP.
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Keycloak bootstrap admin (dev only). Realm import: infra/keycloak/vms-realm.json
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Lab dashboard users (realm vms, password changeme): vms-admin, vms-operator,
# vms-investigator, vms-viewer. Change these in Keycloak after first start.

# Optional lab camera seed. If unset, video-ingest does not insert eyenor_cam1.
# Do not put production camera passwords in git.
# EYENOR_CAM1_RTSP=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/main/av_stream
